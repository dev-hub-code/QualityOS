# Copy to .env. docker compose reads it automatically; every value below has a local-only default.
# Never commit .env, and use unique generated secrets outside local development.
POSTGRES_PASSWORD=change-me
DB_APP_USER=qualityos_app
DB_APP_PASSWORD=change-me
DB_MIGRATION_USER=qualityos_migrator
DB_MIGRATION_PASSWORD=change-me

# Host ports, all bound to 127.0.0.1.
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# RSA keys for signing JWTs (PKCS#8 and X.509 PEM). Without them the local profile generates
# throwaway keys at startup, and the prod profile refuses to start.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Exposes health details and OpenAPI. Use prod to disable both and log as JSON.
SPRING_PROFILES_ACTIVE=local
