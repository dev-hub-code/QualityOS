# One secret holds the application's keys and passwords, as JSON. Terraform creates it with every key empty and never
# reads it back, so no secret is ever in Terraform state or in git. infra/scripts/seed-secrets.sh fills it in.

resource "aws_secretsmanager_secret" "app" {
  #checkov:skip=CKV2_AWS_57:Each value needs its own rotation steps (docs/DEPLOYMENT.md); automatic rotation would sign everyone out or break the database connection
  #checkov:skip=CKV_AWS_149:Encrypted with the AWS-managed key; a customer-managed key is a production decision
  name                    = "${local.prefix}/app"
  description             = "QualityOS ${var.name}: database passwords, signing keys and provider keys. Filled by infra/scripts/seed-secrets.sh."
  recovery_window_in_days = 30
}

locals {
  # Generated by the seed script.
  generated_secrets = ["DB_APP_PASSWORD", "DB_MIGRATION_PASSWORD", "JWT_PRIVATE_KEY", "JWT_PUBLIC_KEY", "SECOND_FACTOR_KEY"]
  # Supplied by the owner from each provider's dashboard.
  provider_secrets = ["SENDGRID_API_KEY", "RAZORPAY_KEY_ID", "RAZORPAY_KEY_SECRET", "RAZORPAY_WEBHOOK_SECRET"]
}

resource "aws_secretsmanager_secret_version" "app_placeholder" {
  secret_id = aws_secretsmanager_secret.app.id
  # Write-only: sent once, never stored in state. The seed script's later versions replace it.
  secret_string_wo         = jsonencode({ for key in concat(local.generated_secrets, local.provider_secrets) : key => "" })
  secret_string_wo_version = 1
}
