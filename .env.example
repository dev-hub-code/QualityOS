# Copy to .env. docker compose reads it automatically; every value below has a local-only default.
# Never commit .env, and use unique generated secrets outside local development.
POSTGRES_PASSWORD=change-me
DB_APP_USER=qualityos_app
DB_APP_PASSWORD=change-me
DB_MIGRATION_USER=qualityos_migrator
DB_MIGRATION_PASSWORD=change-me

# Host ports, all bound to 127.0.0.1.
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
MAILPIT_PORT=8025

# Email. Locally everything is caught by Mailpit; set these to use a real mail server.
# For Gmail, create an app password (2-Step Verification must be on) and use it as SMTP_PASSWORD, not the account
# password. Gmail sends from its own address whatever MAIL_FROM says, so use that address there too.
# In production these same settings point at Amazon SES: host email-smtp.<region>.amazonaws.com, its SMTP credentials,
# and a verified sender.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# MAIL_FROM=QualityOS <you@gmail.com>
# The address users reach the application on, used for links in emails.
# APP_URL=http://localhost:3000
# Cashfree online payment. Without these, invoices are recorded by hand in the Control Center.
# Use test keys with sandbox. Point the Cashfree webhook at <APP_URL>/api/webhooks/cashfree.
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENVIRONMENT=sandbox
# For private development only. The prod profile refuses to start with these changed.
# REGISTRATION_EMAIL_VERIFICATION_REQUIRED=true
# REGISTRATION_ALLOW_UNVERIFIED_LOGIN=false

# Sign-in and account-email requests allowed per address, per minute.
# AUTH_RATE_LIMIT_PER_MINUTE=30

# RSA keys for signing JWTs (PKCS#8 and X.509 PEM). Without them the local profile generates
# throwaway keys at startup, and the prod profile refuses to start.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Exposes health details and OpenAPI. Use prod to disable both and log as JSON.
SPRING_PROFILES_ACTIVE=local

# Printed on invoices. Confirm the GSTIN and SAC code with an accountant before billing a customer.
# BILLING_SELLER_NAME=
# BILLING_SELLER_GSTIN=
# BILLING_SELLER_ADDRESS=
# BILLING_SAC_CODE=
